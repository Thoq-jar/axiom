[
  {
    "id": "plex-media-server",
    "name": "Plex",
    "icon": "fa-solid fa-play-circle",
    "description": "Organize and stream your personal collection of movies, TV shows, and music.",
    "category": "Media",
    "webui_path": "/web",
    "deployment": {
      "image": "lscr.io/linuxserver/plex",
      "tag": "latest",
      "restart_policy": "unless-stopped",
      "ports": [
        { "host": 32400, "container": 32400, "protocol": "tcp" }
      ],
      "volumes": [
        { "host_path": "/opt/plex/config", "container_path": "/config" },
        { "host_path": "/mnt/media", "container_path": "/data" }
      ],
      "env": {
        "PUID": "1000",
        "PGID": "1000",
        "VERSION": "docker"
      }
    },
    "install_steps": [
      {
        "action": "pull_image",
        "target": "lscr.io/linuxserver/plex:latest"
      },
      {
        "action": "create_volume",
        "target": "/opt/plex/config"
      },
      {
        "action": "run_container",
        "name": "plex-server"
      }
    ]
  },
  {
    "id": "pi-hole",
    "name": "Pi-hole",
    "icon": "fa-solid fa-shield",
    "description": "A network-wide ad blocker that acts as a DNS sinkhole to protect your devices.",
    "category": "Network",
    "webui_path": "/admin",
    "deployment": {
      "image": "pihole/pihole",
      "tag": "latest",
      "restart_policy": "always",
      "ports": [
        { "host": 53, "container": 53, "protocol": "udp" },
        { "host": 8080, "container": 80, "protocol": "tcp" }
      ],
      "env": {
        "TZ": "UTC",
        "WEBPASSWORD": "admin"
      }
    },
    "install_steps": [
      { "action": "pull_image", "target": "pihole/pihole:latest" },
      { "action": "run_container", "name": "pihole" }
    ]
  },
  {
    "id": "portainer",
    "name": "Portainer",
    "icon": "fa-solid fa-layer-group",
    "description": "Lightweight container management UI for Docker and Kubernetes environments.",
    "category": "Management",
    "webui_path": "/",
    "deployment": {
      "image": "portainer/portainer-ce",
      "tag": "latest",
      "restart_policy": "always",
      "ports": [
        { "host": 9000, "container": 9000, "protocol": "tcp" }
      ],
      "volumes": [
        {
          "host_path": "/var/run/docker.sock",
          "container_path": "/var/run/docker.sock"
        },
        { "host_path": "/opt/portainer/data", "container_path": "/data" }
      ],
      "env": {}
    },
    "install_steps": [
      { "action": "pull_image", "target": "portainer/portainer-ce:latest" },
      { "action": "run_container", "name": "portainer" }
    ]
  },
  {
    "id": "nextcloud",
    "name": "Nextcloud",
    "icon": "fa-solid fa-cloud",
    "description": "Self-hosted productivity platform for file sync, calendar, contacts, and collaboration.",
    "category": "Storage",
    "webui_path": "/",
    "deployment": {
      "image": "nextcloud",
      "tag": "latest",
      "restart_policy": "always",
      "ports": [
        { "host": 8081, "container": 80, "protocol": "tcp" }
      ],
      "volumes": [
        {
          "host_path": "/opt/nextcloud/data",
          "container_path": "/var/www/html"
        }
      ],
      "env": {
        "NEXTCLOUD_ADMIN_USER": "admin",
        "NEXTCLOUD_ADMIN_PASSWORD": "changeme"
      }
    },
    "install_steps": [
      { "action": "pull_image", "target": "nextcloud:latest" },
      { "action": "run_container", "name": "nextcloud" }
    ]
  },
