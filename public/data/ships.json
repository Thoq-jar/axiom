  {
    "id": "nginx-proxy-manager",
    "name": "Nginx Proxy Manager",
    "icon": "fa-solid fa-server",
    "description": "Easily forward services with free SSL, no command line required.",
    "category": "Network",
    "webui_path": "/",
    "deployment": {
      "image": "jc21/nginx-proxy-manager",
      "tag": "latest",
      "restart_policy": "unless-stopped",
      "ports": [
        { "host": 80, "container": 80, "protocol": "tcp" },
        { "host": 443, "container": 443, "protocol": "tcp" },
        { "host": 81, "container": 81, "protocol": "tcp" }
      ],
      "volumes": [
        { "host_path": "/opt/npm/data", "container_path": "/data" },
        {
          "host_path": "/opt/npm/letsencrypt",
          "container_path": "/etc/letsencrypt"
        }
      ],
      "env": {}
    },
    "install_steps": [
      { "action": "pull_image", "target": "jc21/nginx-proxy-manager:latest" },
      { "action": "run_container", "name": "nginx-proxy-manager" }
    ]
  }
]
