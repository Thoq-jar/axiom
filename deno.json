{
  "nodeModulesDir": "auto",
  "permissions": {
    "default": {
      "net": true,
      "read": true,
      "run": true,
      "all": true
    }
  },
  "compilerOptions": {
    "lib": ["esnext", "dom", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["vite/client"]
  },
  "tasks": {
    "start": "deno run -P src/main.ts",
    "dev": {
      "dependencies": [
        "dev:backend",
        "dev:vite"
      ]
    },
    "dev:vite": "vite",
    "dev:backend": "deno run -P src/main.ts",
    "build:vite": "vite build",
    "preview": "vite preview",
    "start:prod": "deno run -P scripts/prod.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.2.1",
    "lucide-preact": "npm:lucide-preact@0.577.0",
    "monaco-editor": "npm:monaco-editor@0.52.2",
    "node-pty": "npm:node-pty@^1.1.0",
    "preact": "npm:preact@10.28.4",
    "@preact/preset-vite": "npm:@preact/preset-vite@2.10.3",
    "tailwindcss": "npm:tailwindcss@4.2.1",
    "vite": "npm:vite@7.3.1",
    "lucide": "npm:lucide@0.453.0",
    "~/": "./"
  },
  "allowScripts": ["npm:esbuild@0.27.3", "npm:fsevents@2.3.3", "npm:node-pty@1.1.0"]
}
