[Unit]
Description=Axiom
After=network.target

[Service]
Type=simple
User=axiom
SupplementaryGroups=docker
WorkingDirectory=/opt/axiom
ExecStart=/opt/deno/bin/deno task start:prod
Environment=DENO_DIR=/opt/axiom/.deno-cache
EnvironmentFile=-/etc/axiom/env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
